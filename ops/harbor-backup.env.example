HARBOR_BACKUP_INSTANCE=harbor-main
HARBOR_BACKUP_DRIVER=mysql
HARBOR_BACKUP_MYSQL_DB=harbor_mail
RESTIC_REPOSITORY=/srv/harbor-backups/repository

# For SQLite, switch drivers and set the actual database path.
# HARBOR_BACKUP_DRIVER=sqlite
# HARBOR_BACKUP_SQLITE=/var/lib/harbormail/harbor.db

# Set this to a node_exporter textfile directory writable by the backup user.
# HARBOR_BACKUP_METRIC_DIR=/var/lib/node_exporter/textfile
