# 原生 MX 直投需要公网 TCP 25 出站。HELO 应与公网 IP 的 PTR 一致。
HARBOR_DIRECT_MX=true
HARBOR_DIRECT_MX_HELO=
HARBOR_DIRECT_MX_TLS=required
HARBOR_DOMAIN=harbor.test
HARBOR_WEB=127.0.0.1:8080
HARBOR_SMTP=127.0.0.1:2525
HARBOR_DB_DRIVER=sqlite
HARBOR_DB=/var/lib/harbormail/harbor.db
HARBOR_DKIM_LOCAL_KEY_FILE=/var/lib/harbormail/dkim-key
# HARBOR_MAX_MESSAGE_MIB=32
# HARBOR_MAX_ATTACHMENTS_MIB=20
# HARBOR_INBOUND_MAX_INFLIGHT=4
# HARBOR_INBOUND_MAX_MIB=64
# HARBOR_INBOUND_SCAN_CONCURRENCY=2
# HARBOR_SUBMISSION_MAX_INFLIGHT=4
# HARBOR_SUBMISSION_MAX_MIB=64
# HARBOR_RSPAMD_URL=http://127.0.0.1:11333/checkv2
# HARBOR_VIRUS_ACTION=quarantine
# HARBOR_SCAN_FAILURE=defer

# Optional Microsoft Translator key file and Azure resource region
# HARBOR_TRANSLATOR_KEY_FILE=/etc/harbormail/translator-key
# HARBOR_TRANSLATOR_REGION=eastus

# Optional alternative translation services
# HARBOR_GOOGLE_TRANSLATE_KEY_FILE=/etc/harbormail/google-translate-key
# HARBOR_DEEPL_FREE_KEY_FILE=/etc/harbormail/deepl-free-key
# HARBOR_LIBRETRANSLATE_URL=http://127.0.0.1:5000
# HARBOR_LIBRETRANSLATE_KEY_FILE=/etc/harbormail/libretranslate-key
