[Unit]
Description=Harbor Mail
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=harbormail
Group=harbormail
StateDirectory=harbormail
StateDirectoryMode=0700
WorkingDirectory=/var/lib/harbormail
EnvironmentFile=/etc/harbormail/harbormail.env
LoadCredential=accounts.json:/etc/harbormail/accounts.json
Environment=HARBOR_ACCOUNTS_FILE=%d/accounts.json
ExecStart=/usr/local/bin/harbormail
Restart=on-failure
RestartSec=5s
TimeoutStopSec=125s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
